---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Button from "../../components/Button.astro";
import ProductCard from "../../components/ProductCard.astro";

export async function getStaticPaths() {
	const guides = await getCollection("guides");

	return guides.map((guide) => ({
		params: {
			slug: guide.id,
		},
		props: {
			guide,
		},
	}));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const locale = Astro.currentLocale ?? "en";
const normalize = (value: string) => value.trim().toLocaleLowerCase("en-US");
const products = await getCollection("products", ({ data }) => data.productType !== "digital" || data.published);
const relatedProducts = products.filter((product) =>
	product.data.tags.some((tag) =>
		guide.data.tags.some((guideTag) => normalize(guideTag) === normalize(tag)),
	),
);
---

<Layout
	title={`${guide.data.title} | The Peak Collection`}
	description={guide.data.description}
>
	<div class="guide-detail">
		<div class="container">
			<Breadcrumbs
				items={[
					{ label: "Home", href: getRelativeLocaleUrl(locale) },
					{ label: "Guides", href: getRelativeLocaleUrl(locale, "guides") },
					{ label: guide.data.title },
				]}
			/>

			<article>
				<header class="guide-header">
					<p class="eyebrow">{guide.data.category}</p>

					<h1>{guide.data.title}</h1>

					<p class="description">
						{guide.data.description}
					</p>

					{guide.data.date && (
						<time datetime={guide.data.date.toISOString()}>
							{guide.data.date.toLocaleDateString("en-US", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</time>
					)}
				</header>

				{guide.data.featuredImage && (
					<div class="guide-featured-image">
						<Image
							src={guide.data.featuredImage}
							alt={guide.data.title}
							width={1200}
							loading="eager"
						/>
					</div>
				)}

				<div class="guide-content">
					<Content />
				</div>

				{relatedProducts.length > 0 && (
					<section class="related-products" aria-labelledby="related-products-title">
						<h2 id="related-products-title">Related products to explore</h2>
						<div class="related-products__grid">
							{relatedProducts.map((product) => (
								<ProductCard
									title={product.data.title}
									description={product.data.description}
									category={product.data.category}
									image={product.data.featuredImage}
									href={getRelativeLocaleUrl(locale, `products/${product.id}`)}
								/>
							))}
						</div>
					</section>
				)}

				<div class="guide-footer">
					<Button href={getRelativeLocaleUrl(locale, "guides")} variant="secondary">
						Back to Guides
					</Button>
				</div>
			</article>
		</div>
	</div>
</Layout>

<style>
	.guide-detail {
		padding: 3rem 1.25rem 6rem;
	}

	.container {
		width: min(900px, 100%);
		margin: 0 auto;
	}

	.guide-header {
		max-width: 760px;
		margin: 3rem auto 3.5rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;

		font-size: 0.85rem;
		font-weight: 700;

		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	h1 {
		margin: 0;

		font-size: clamp(2.2rem, 6vw, 4rem);
		line-height: 1.05;
	}

	.description {
		margin: 1.25rem 0 1rem;

		font-size: 1.15rem;
		line-height: 1.7;

		color: var(--color-muted);
	}

	time {
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	.guide-featured-image {
		max-width: 860px;
		margin: 0 auto 4rem;
		overflow: hidden;
		border-radius: 20px;
	}

	.guide-featured-image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.guide-content {
		max-width: 760px;
		margin: 0 auto;

		font-size: 1.05rem;
		line-height: 1.8;
	}

	.guide-content :global(h2) {
		margin-top: 2.5rem;
		line-height: 1.2;
	}

	.guide-content :global(h3) {
		margin-top: 2rem;
		line-height: 1.3;
	}

	.guide-content :global(p) {
		margin: 1rem 0;
	}

	.guide-content :global(ul),
	.guide-content :global(ol) {
		padding-left: 1.5rem;
	}

	.guide-content :global(a) {
		text-decoration: underline;
	}

	.guide-footer {
		max-width: 760px;
		margin: 3rem auto 0;
	}

	.related-products {
		max-width: 760px;
		margin: 3rem auto 0;
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-border);
	}

	.related-products h2 {
		margin-bottom: 1.5rem;
		font-size: clamp(1.6rem, 3vw, 2.25rem);
	}

	.related-products__grid {
		display: grid;
		grid-template-columns: minmax(0, 380px);
	}

	@media (max-width: 640px) {
		.guide-detail {
			padding: 2rem 1rem 4rem;
		}

		.guide-header {
			margin-top: 2rem;
		}

		.guide-featured-image {
			margin-bottom: 3rem;
			border-radius: 14px;
		}
	}
</style>
