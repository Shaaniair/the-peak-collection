---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<Layout
	title="Affiliate Disclosure | The Peak Collection"
	description="Read The Peak Collection's affiliate disclosure and learn how affiliate relationships may support the website."
>
	<section class="legal-page">
		<div class="container">
			<Breadcrumbs
				items={[
					{ label: "Home", href: "/" },
					{ label: "Affiliate Disclosure" },
				]}
			/>

			<header class="legal-header">
				<p class="eyebrow">Transparency</p>
				<h1>Affiliate Disclosure</h1>
				<p>
					Some links on The Peak Collection may be affiliate links.
				</p>
			</header>

			<article class="legal-content">
				<h2>How Affiliate Links Work</h2>
				<p>
					When you click an affiliate link and make a qualifying purchase,
					The Peak Collection may receive a commission from the retailer
					or affiliate program.
				</p>

				<h2>Our Approach</h2>
				<p>
					Affiliate relationships do not change the need for clear,
					useful and accurate product information. We aim to provide
					content that helps visitors research products and make their
					own purchasing decisions.
				</p>

				<h2>Prices and Availability</h2>
				<p>
					Product prices, specifications, promotions and availability can
					change. Always verify the current information on the retailer's
					website before purchasing.
				</p>
			</article>
		</div>
	</section>
</Layout>

<style>
	.legal-page {
		padding: 3rem 1.25rem 6rem;
	}

	.container {
		width: min(900px, 100%);
		margin: 0 auto;
	}

	.legal-header {
		max-width: 760px;
		margin: 4rem 0;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1;
	}

	.legal-header > p {
		margin-top: 1.25rem;
		color: var(--color-muted);
		font-size: 1.1rem;
	}

	.legal-content {
		border-top: 1px solid var(--color-border);
		padding-top: 3rem;
	}

	.legal-content h2 {
		margin: 2.5rem 0 0.75rem;
		font-size: 1.5rem;
	}

	.legal-content h2:first-child {
		margin-top: 0;
	}

	.legal-content p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.8;
	}

	@media (max-width: 640px) {
		.legal-page {
			padding: 2rem 1rem 4rem;
		}

		.legal-header {
			margin: 3rem 0;
		}
	}
</style>