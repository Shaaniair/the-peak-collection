---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionHeading from "../components/SectionHeading.astro";

const products = await getCollection("products");
---

<Layout
	title="Products | The Peak Collection"
	description="Explore products and useful finds discovered by The Peak Collection."
>
	<section class="products-page">
		<div class="container">
			<SectionHeading
				title="Products"
				description="Explore useful products, thoughtful gifts and interesting finds."
			/>

			<div class="product-grid">
				{products.map((product) => (
					<ProductCard
						title={product.data.title}
						description={product.data.description}
						category={product.data.category}
						image={product.data.featuredImage}
						href={`/products/${product.id}/`}
					/>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.products-page {
		padding: 4rem 1.25rem 5rem;
	}

	.container {
		width: min(1100px, 100%);
		margin: 0 auto;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.products-page {
			padding: 3rem 1rem 4rem;
		}

		.product-grid {
			grid-template-columns: 1fr;
		}
	}
</style>