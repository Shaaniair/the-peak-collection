---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProductCard from "../components/ProductCard.astro";
import GuideCard from "../components/GuideCard.astro";
import Button from "../components/Button.astro";
import { useTranslations } from "../i18n/utils";
import type { SupportedLocale } from "../i18n/ui";

const products = await getCollection("products", ({ data }) => data.productType !== "digital");
const guides = await getCollection("guides");
const locale = (Astro.currentLocale ?? "en") as SupportedLocale;
const t = useTranslations(locale);

const featuredProducts = products.slice(0, 3);
const latestGuides = guides.slice(0, 3);
---

<Layout
	title={`${t('nav.discover')} | The Peak Collection`}
	description={t('discover.hero.description')}
>
	<section class="discover-hero">
		<div class="container hero-inner">
			<span class="eyebrow">{t('nav.discover')}</span>

			<h1>{t('discover.hero.title')}</h1>

			<p>
				{t('discover.hero.description')}
			</p>

						<div class="hero-actions">
				<Button href={getRelativeLocaleUrl(locale, "products")} variant="primary" size="large">
					{t('action.exploreProducts')}
				</Button>

				<Button href={getRelativeLocaleUrl(locale, "guides")} variant="secondary" size="large">
					{t('action.exploreAllGuides')}
				</Button>

				<Button href={getRelativeLocaleUrl(locale, "digital-products")} variant="accent" size="large">
					{t('action.exploreDigital')}
				</Button>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHeading
				eyebrow={t('nav.products')}
				title={t('discover.products.title')}
				description={t('discover.products.description')}
			/>

			<div class="product-grid">
				{featuredProducts.map((product) => (
					<ProductCard
						title={product.data.title}
						description={product.data.description}
						category={product.data.category}
						image={product.data.featuredImage}
						href={getRelativeLocaleUrl(locale, `products/${product.id}`)}
					/>
				))}
			</div>

			<div class="section-action">
				<Button href={getRelativeLocaleUrl(locale, "products")} variant="text">
					{t('action.viewAll')}
				</Button>
			</div>
		</div>
	</section>

	<section class="section section-muted">
		<div class="container">
			<SectionHeading
				eyebrow={t('nav.guides')}
				title={t('discover.guides.title')}
				description={t('discover.guides.description')}
			/>

			<div class="guide-grid">
				{latestGuides.map((guide) => (
					<GuideCard
						title={guide.data.title}
						description={guide.data.description}
						category={guide.data.category}
						href={getRelativeLocaleUrl(locale, `guides/${guide.id}`)}
					/>
				))}
			</div>

			<div class="section-action">
				<Button href={getRelativeLocaleUrl(locale, "guides")} variant="text">
					{t('action.exploreAllGuides')}
				</Button>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container final-cta">
			<span class="eyebrow">THE PEAK COLLECTION</span>

			<h2>{t('discover.cta.title')}</h2>

			<p>
				{t('discover.cta.description')}
			</p>

			<Button href={getRelativeLocaleUrl(locale, "products")} variant="primary" size="large">
				{t('discover.cta.button')}
			</Button>
		</div>
	</section>
</Layout>

<style>
	.discover-hero {
		padding: 5rem 1.25rem 4.5rem;
		background:
			radial-gradient(circle at top right, var(--color-accent-soft), transparent 38%),
			var(--color-surface-muted);
	}

	.container {
		width: min(1100px, 100%);
		margin: 0 auto;
	}

	.hero-inner {
		max-width: 780px;
		text-align: center;
		margin: 0 auto;
	}

	.eyebrow {
		display: inline-block;
		margin-bottom: 1rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent-strong);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.6rem, 7vw, 5.5rem);
		line-height: 0.98;
		letter-spacing: -0.045em;
	}

	.hero-inner p {
		max-width: 620px;
		margin: 1.5rem auto 0;
		font-size: clamp(1rem, 2vw, 1.2rem);
		color: var(--color-muted);
	}

	.hero-actions {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.8rem;
		width: 100%;
		margin-top: 2rem;
	}

	.hero-actions > .button {
		width: 100%;
		min-width: 0;
	}

	.section {
		padding: 6rem 1.25rem;
	}

	.section-muted {
		background: var(--color-surface-muted);
	}

	.product-grid,
	.guide-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin-top: 2.5rem;
	}

	.section-action {
		display: flex;
		justify-content: center;
		margin-top: 2.25rem;
	}

	.final-cta {
		max-width: 720px;
		text-align: center;
	}

	.final-cta h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.035em;
	}

	.final-cta p {
		max-width: 580px;
		margin: 1.25rem auto 2rem;
		color: var(--color-muted);
	}

	html.dark .discover-hero h1 { color: var(--color-text-strong); }
	html.dark .discover-hero .eyebrow { color: var(--color-secondary); }
	html.dark .hero-inner p,
	html.dark .final-cta p { color: var(--color-muted); }

	@media (max-width: 900px) {
		.product-grid,
		.guide-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 840px) {
		.hero-actions {
			grid-template-columns: minmax(0, 360px);
			justify-content: center;
		}
	}

	@media (max-width: 640px) {
		.discover-hero {
			padding: 5rem 1rem 4rem;
		}

		.section {
			padding: 4rem 1rem;
		}

		.product-grid,
		.guide-grid {
			grid-template-columns: 1fr;
		}

	}
</style>
