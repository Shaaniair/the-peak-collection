---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";
---

<Layout
	title="Page Not Found | The Peak Collection"
	description="The page you're looking for could not be found."
	noindex={true}
>
	<section class="not-found">
		<div class="container">
			<p class="eyebrow">404</p>

			<h1>That page doesn't exist.</h1>

			<p class="description">
				The page you are looking for may have moved, changed or no longer
				be available.
			</p>

			<div class="actions">
				<Button href={getRelativeLocaleUrl(locale)} variant="primary" size="large">
					Back to Home
				</Button>

				<Button href={getRelativeLocaleUrl(locale, "products")} variant="secondary" size="large">
					Explore Products
				</Button>
			</div>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		min-height: 65vh;
		display: flex;
		align-items: center;
		padding: 5rem 1.25rem;
	}

	.container {
		width: min(850px, 100%);
		margin: 0 auto;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 7vw, 5.5rem);
		line-height: 0.98;
		letter-spacing: -0.05em;
	}

	.description {
		max-width: 600px;
		margin: 1.5rem auto 0;
		color: var(--color-muted);
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	@media (max-width: 640px) {
		.not-found {
			min-height: 60vh;
			padding: 4rem 1rem;
		}

		.actions {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
