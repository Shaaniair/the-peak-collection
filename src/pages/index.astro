---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProductCard from "../components/ProductCard.astro";
import Button from "../components/Button.astro";
import { useTranslations } from "../i18n/utils";
import type { SupportedLocale } from "../i18n/ui";

const products = await getCollection("products");
const locale = (Astro.currentLocale ?? "en") as SupportedLocale;
const t = useTranslations(locale);

const featuredProduct = products.find(
	(product) => product.id === "cozyberry-candle-warmer"
);
---

<Layout
	title={`The Peak Collection | ${t('footer.tagline')}`}
	description={t('discover.hero.description')}
>
	<div class="home">
		<section class="hero">
			<div class="container hero__inner">
				<div class="hero__content">
					<p class="eyebrow">THE PEAK COLLECTION</p>

					<h1>{t('discover.hero.title')}</h1>

					<p class="hero__description">
						{t('discover.hero.description')}
					</p>

										<div class="hero__actions">
	<Button href={getRelativeLocaleUrl(locale, "products")} variant="primary" size="large">
		{t('action.exploreProducts')}
	</Button>

	<Button href={getRelativeLocaleUrl(locale, "guides")} variant="secondary" size="large">
		{t('action.exploreAllGuides')}
	</Button>
</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<SectionHeading
					eyebrow={t('nav.discover')}
					title={t('discover.products.title')}
					description={t('discover.products.description')}
				/>

								{featuredProduct && (
	<div class="featured-product">
		<ProductCard
			title={locale === 'en' ? featuredProduct.data.title : t('product.candleWarmer.title')}
			description={locale === 'en' ? featuredProduct.data.description : t('product.candleWarmer.description')}
			category={locale === 'en' ? featuredProduct.data.category : t('product.candleWarmer.category')}
			image={featuredProduct.data.featuredImage}
			href={getRelativeLocaleUrl(locale, `products/${featuredProduct.id}`)}
			featured={true}
		/>
	</div>
)}
			</div>
		</section>

		<section class="section section--muted">
			<div class="container">
				<SectionHeading
					eyebrow={t('nav.discover')}
					title={t('discover.cta.title')}
					description={t('discover.cta.description')}
				/>

				<div class="explore-grid">
					<a href={getRelativeLocaleUrl(locale, "products")} class="explore-card">
						<span class="explore-card__number">01</span>
						<h2>{t('nav.products')}</h2>
						<p>
							{t('discover.hero.description')}
						</p>
						<span class="explore-card__link"><span>{t('nav.products')}</span><span class="explore-card__arrow cta-arrow" aria-hidden="true"><span class="cta-arrow__resting">&#8594;</span><span class="cta-arrow__lifted">&#8599;</span></span></span>
					</a>

					<a href={getRelativeLocaleUrl(locale, "guides")} class="explore-card">
						<span class="explore-card__number">02</span>
						<h2>{t('nav.guides')}</h2>
						<p>
							{t('discover.guides.description')}
						</p>
						<span class="explore-card__link"><span>{t('action.exploreAllGuides')}</span><span class="explore-card__arrow cta-arrow" aria-hidden="true"><span class="cta-arrow__resting">&#8594;</span><span class="cta-arrow__lifted">&#8599;</span></span></span>
					</a>

										<a href={getRelativeLocaleUrl(locale, "categories")} class="explore-card">
						<span class="explore-card__number">03</span>
						<h2>{t('nav.categories')}</h2>
						<p>
							{t('categories.card.description')}
						</p>
						<span class="explore-card__link"><span>{t('nav.categories')}</span><span class="explore-card__arrow cta-arrow" aria-hidden="true"><span class="cta-arrow__resting">&#8594;</span><span class="cta-arrow__lifted">&#8599;</span></span></span>
					</a>

					<a href={getRelativeLocaleUrl(locale, "digital-products")} class="explore-card">
						<span class="explore-card__number">04</span>
						<h2>{t('hub.digital.title')}</h2>
						<p>{t('hub.digital.subtitle')}</p>
						<span class="explore-card__link"><span>{t('action.exploreDigital')}</span><span class="explore-card__arrow cta-arrow" aria-hidden="true"><span class="cta-arrow__resting">&#8594;</span><span class="cta-arrow__lifted">&#8599;</span></span></span>
					</a>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container about-preview">
				<div>
					<p class="eyebrow">ABOUT THE PEAK COLLECTION</p>
					<h2>{t('footer.tagline')}</h2>
				</div>

				<div>
					<p>
						{t('discover.hero.description')}
					</p>

					<a href={getRelativeLocaleUrl(locale, "about")} class="text-link">{t('nav.about')} →</a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.home {
		overflow: hidden;
	}

	.container {
		width: min(1100px, calc(100% - 2.5rem));
		margin: 0 auto;
	}

	.hero {
		padding: 3.5rem 0 3.75rem;
		background:
			radial-gradient(circle at 86% 14%, var(--color-accent-soft), transparent 36%),
			linear-gradient(180deg, var(--color-surface-muted), var(--color-background));
}

html.dark .hero {
		background:
			radial-gradient(
				circle at 78% 18%,
				rgba(124, 58, 237, 0.16),
				transparent 34%
			),
		radial-gradient(
			circle at 18% 80%,
			rgba(34, 211, 238, 0.12),
			transparent 32%
		),
		linear-gradient(
			135deg,
			#09090b 0%,
			#11111a 48%,
			#0b0b0f 100%
		);
}

	.hero__content {
		max-width: 800px;
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	h1 {
		max-width: 800px;
		margin: 0;
		font-size: clamp(3rem, 8vw, 6.5rem);
		line-height: 0.95;
		letter-spacing: -0.055em;
	}

	html.dark h1 {
	background:
		linear-gradient(
			110deg,
			#ffffff 0%,
			#d8b4fe 38%,
			#93c5fd 72%,
			#67e8f9 100%
		);
	-webkit-background-clip: text;
	background-clip: text;
	color: transparent;
}

	.hero__description {
	max-width: 650px;
	margin: 2rem 0 0;
	font-size: clamp(1.1rem, 2vw, 1.35rem);
	line-height: 1.7;
	color: var(--color-muted);
}

html.dark .hero__description {
	color: var(--color-muted);
}

html.dark .hero .eyebrow { color: var(--color-secondary); }

	.hero__actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		width: min(100%, 560px);
		gap: 0.9rem;
		margin-top: 2.25rem;
	}

	.hero__actions > .button {
		width: 100%;
		min-width: 0;
	}

	.section {
		padding: 6rem 0;
	}

	.section--muted { background: var(--color-surface-muted); }

html.dark .section--muted { background: var(--color-surface-muted); }

	.featured-product {
		width: min(100%, 390px);
		margin-top: 2.5rem;
	}

	.explore-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
		gap: 1.25rem;
		margin-top: 2.5rem;
		align-items: stretch;
	}

	.explore-card {
		min-width: 0;
	display: flex;
	flex-direction: column;

	min-height: 270px;
	padding: clamp(1.25rem, 2.5vw, 2rem);

	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);

	background: var(--color-surface);

	color: var(--color-text);
	text-decoration: none;

	box-shadow: var(--shadow-card);

	transition:
		transform var(--transition-normal),
		box-shadow var(--transition-normal),
		border-color var(--transition-normal);
}

	.explore-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card-hover);
		border-color: var(--color-accent-strong);
	}

	.explore-card__number {
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--color-muted);
	}

	.explore-card h2 {
		margin: 2rem 0 0.75rem;
		font-size: 1.7rem;
	}

	.explore-card p {
		margin: 0;
		line-height: 1.65;
		color: var(--color-muted);
	}

	.explore-card__link {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		gap: 0.55rem;
		margin-top: auto;
		max-width: 100%;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--color-glass-border);
		border-radius: 999px;
		background: var(--color-glass-surface);
		color: var(--color-accent-strong);
		font-weight: 700;
		line-height: 1.35;
		transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
	}

	.explore-card__arrow {
		font-size: 1rem;
		line-height: 1;
	}

		.explore-card__link:hover,
	.explore-card__link:focus-visible {
		border-color: var(--color-action-hover);
		background: var(--color-accent-soft);
		color: var(--color-text-strong);
		box-shadow: 0 4px 14px var(--color-action-glow), 0 0 0 1px var(--color-violet-glow);
	}

	.about-preview {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: start;
	}

	.about-preview h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

	.about-preview p {
		margin-top: 0;
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--color-muted);
	}

	html.dark .about-preview p { color: var(--color-muted); }

	.text-link {
		font-weight: 700;
		color: var(--color-accent-strong);
		text-decoration: none;
	}

	html.dark .text-link { color: var(--color-accent); }

	@media (max-width: 800px) {
		.hero {
			padding: 3rem 0 3.25rem;
}

		.section {
			padding: 4rem 0;
		}

		.about-preview {
			grid-template-columns: 1fr;
		}

		.explore-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.container {
			width: min(100% - 2rem, 1100px);
		}

		h1 {
			font-size: clamp(2.7rem, 15vw, 4.5rem);
		}

		.hero__actions {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		.explore-grid {
			grid-template-columns: 1fr;
		}

		.button {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button,
		.explore-card,
		.explore-card__link {
			transition: none;
		}
	}
</style>
