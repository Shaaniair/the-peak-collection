---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProductCard from "../../components/ProductCard.astro";

const products = await getCollection("products", ({ data }) => data.productType !== "digital");
const locale = Astro.currentLocale ?? "en";

const sortedProducts = [...products].sort((a, b) => {
	const dateA = a.data.date?.getTime() ?? 0;
	const dateB = b.data.date?.getTime() ?? 0;

	return dateB - dateA;
});

const featuredProducts = sortedProducts.filter(
	(product) => product.data.featured
);

const regularProducts = sortedProducts.filter(
	(product) => !product.data.featured
);
---

<Layout
	title="Products | The Peak Collection"
	description="Explore useful products, thoughtful gifts, home finds and practical discoveries from The Peak Collection."
>
	<div class="products-page">
		<div class="container">

			<header class="products-header">
				<SectionHeading
					level="h1"
					eyebrow="Discover Something Worth Having"
					title="Explore Products"
					description="Browse our growing collection of useful products, thoughtful gifts, home finds and practical discoveries."
				/>
			</header>

			{sortedProducts.length > 0 ? (

				<div class="products-content">

					{featuredProducts.length > 0 && (
						<section
							class="products-section products-section--featured"
							aria-labelledby="featured-products-title"
						>
							<div class="section-intro">
								<div>
									<p class="section-eyebrow">
										Featured Discoveries
									</p>

									<h2 id="featured-products-title">
										Worth Exploring
									</h2>
								</div>

								<p>
									A selection of products currently highlighted
									by The Peak Collection.
								</p>
							</div>

							<div class="product-grid product-grid--featured">
								{featuredProducts.map((product) => (
									<ProductCard
										title={product.data.title}
										description={product.data.description}
										category={product.data.category}
										image={product.data.featuredImage}
										href={getRelativeLocaleUrl(locale, `products/${product.id}`)}
										featured={true}
									/>
								))}
							</div>
						</section>
					)}

					{regularProducts.length > 0 && (
	<section
		class="products-section"
		aria-labelledby="all-products-title"
	>
		<div class="section-intro">
			<div>
				<p class="section-eyebrow">
					Product Collection
				</p>

				<h2 id="all-products-title">
					All Products
				</h2>
			</div>

			<p>
				Explore the growing collection of products and discoveries.
			</p>
		</div>

		<div class="product-grid">
			{regularProducts.map((product) => (
				<ProductCard
					title={product.data.title}
					description={product.data.description}
					category={product.data.category}
					image={product.data.featuredImage}
					href={getRelativeLocaleUrl(locale, `products/${product.id}`)}
				/>
			))}
		</div>
	</section>
)}

				</div>

			) : (

				<section class="empty-state" aria-live="polite">
					<div class="empty-state__content">

						<p class="empty-state__eyebrow">
							Coming Soon
						</p>

						<h2>
							Our product collection is growing.
						</h2>

						<p>
							We are currently preparing more discoveries for
							The Peak Collection. Please check back soon.
						</p>

					</div>
				</section>

			)}

		</div>
	</div>
</Layout>

<style>
	.products-page {
		padding: 4rem 1.25rem 6rem;
	}

	.container {
		width: min(1100px, 100%);
		margin: 0 auto;
	}

	.products-header {
		max-width: 900px;
		margin: 0 auto;
	}

	.products-content {
		margin-top: 4rem;
	}

	.products-section {
		margin-top: 5rem;
	}

	.products-section:first-child {
		margin-top: 0;
	}

	.products-section--featured {
		padding-bottom: 5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.section-intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: end;
		margin-bottom: 2rem;
	}

	.section-eyebrow {
		margin: 0 0 0.6rem;

		font-size: 0.78rem;
		font-weight: 800;

		letter-spacing: 0.12em;
		text-transform: uppercase;

		color: var(--color-muted);
	}

	.section-intro h2 {
		margin: 0;

		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.05;
	}

	.section-intro > p {
		max-width: 480px;
		margin: 0;

		color: var(--color-muted);

		line-height: 1.7;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.product-grid--featured {
	grid-template-columns: repeat(
		auto-fit,
		minmax(280px, 360px)
	);

	align-items: stretch;
}

.products-section--featured .product-grid--featured {
	justify-content: start;
}

	.empty-state {
		margin-top: 4rem;
		padding: 4rem 1.5rem;

		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);

		background: var(--color-surface);

		text-align: center;
	}

	.empty-state__content {
		width: min(620px, 100%);
		margin: 0 auto;
	}

	.empty-state__eyebrow {
		margin: 0 0 0.75rem;

		font-size: 0.8rem;
		font-weight: 700;

		letter-spacing: 0.08em;
		text-transform: uppercase;

		color: var(--color-muted);
	}

	.empty-state h2 {
		margin: 0;

		font-size: clamp(1.8rem, 4vw, 2.5rem);
		line-height: 1.15;
	}

	.empty-state p:last-child {
		max-width: 560px;
		margin: 1rem auto 0;

		color: var(--color-muted);

		line-height: 1.7;
	}

	@media (max-width: 900px) {
		.section-intro {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.products-page {
			padding: 3rem 1rem 4rem;
		}

		.products-content {
			margin-top: 3rem;
		}

		.products-section {
			margin-top: 4rem;
		}

		.products-section--featured {
			padding-bottom: 4rem;
		}

		.product-grid,
		.product-grid--featured {
			grid-template-columns: 1fr;
		}

		.empty-state {
			margin-top: 3rem;
			padding: 3rem 1.25rem;
		}
	}
</style>
