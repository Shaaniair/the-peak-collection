---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "The Peak Collection | Discover Something Worth Having",
	description = "The Peak Collection helps you discover useful products, thoughtful gifts, home finds and practical buying ideas.",
} = Astro.props;

const canonicalURL = Astro.url;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta name="generator" content={Astro.generator} />

		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" href="/favicon.ico" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="The Peak Collection" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<meta
			name="theme-color"
			content="#111111"
		/>
	</head>

	<body>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		margin: 0;
		padding: 0;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		padding: 0;
		min-width: 320px;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		background: #ffffff;
		color: #111111;
		line-height: 1.6;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(255, 255, 255, 0.96);
		border-bottom: 1px solid #e8e8e8;
		backdrop-filter: blur(12px);
	}

	.header-inner {
		width: min(1200px, calc(100% - 40px));
		margin: 0 auto;
		min-height: 72px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #111111;
		text-decoration: none;
		font-weight: 700;
		white-space: nowrap;
	}

	.brand-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 10px;
		background: #111111;
		color: #ffffff;
		font-size: 12px;
		letter-spacing: 0.08em;
	}

	.brand-name {
		font-size: 17px;
		letter-spacing: -0.02em;
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.main-nav a,
	.footer-links a {
		color: #333333;
		text-decoration: none;
		font-size: 14px;
	}

	.main-nav a:hover,
	.footer-links a:hover {
		color: #000000;
	}

	main {
		min-height: 60vh;
	}

	.site-footer {
		margin-top: 80px;
		border-top: 1px solid #e8e8e8;
		background: #fafafa;
	}

	.footer-inner {
		width: min(1200px, calc(100% - 40px));
		margin: 0 auto;
		padding: 48px 0 24px;
	}

	.footer-brand strong {
		font-size: 18px;
	}

	.footer-brand p {
		margin: 6px 0 24px;
		color: #666666;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
	}

	.footer-bottom {
		margin-top: 32px;
		padding-top: 20px;
		border-top: 1px solid #e5e5e5;
		color: #777777;
		font-size: 13px;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 800px) {
		.header-inner {
			min-height: 64px;
			width: min(100% - 28px, 1200px);
		}

		.main-nav {
			gap: 12px;
			overflow-x: auto;
			white-space: nowrap;
		}

		.brand-name {
			display: none;
		}

		.main-nav a {
			font-size: 13px;
		}

		.footer-inner {
			width: min(100% - 28px, 1200px);
		}
	}
</style>