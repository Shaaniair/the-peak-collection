---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BackToTop from "../components/BackToTop.astro";
import { getLangFromUrl, getLocaleDirection } from "../i18n/utils";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = "The Peak Collection | Discover Something Worth Having",
	description = "The Peak Collection helps you discover useful products, thoughtful gifts, home finds and practical buying ideas.",
	noindex = false,
} = Astro.props;

const currentLocale = getLangFromUrl(Astro.url);
const dir = getLocaleDirection(currentLocale);

const siteUrl = Astro.site ? Astro.site.origin : (import.meta.env.PUBLIC_SITE_URL || import.meta.env.SITE_URL || 'https://thepeakcollection.com');
const currentPath = Astro.url.pathname;
const computedCanonical = `${siteUrl}${currentPath}`;
const defaultOgImage = `${siteUrl}/images/og-default.png`;

const supportedLocales = ["en", "tr", "ar", "ur", "es", "fr", "de", "it", "pt", "id", "ja", "ko", "zh"] as const;

let basePath = currentPath;
for (const loc of supportedLocales) {
	if (loc !== 'en') {
		if (basePath === `/${loc}` || basePath === `/${loc}/`) {
			basePath = '/';
			break;
		} else if (basePath.startsWith(`/${loc}/`)) {
			basePath = basePath.slice(loc.length + 1);
			break;
		}
	}
}

const hreflangLinks = supportedLocales.map((loc) => {
	const locPath = loc === 'en' ? basePath : `/${loc}${basePath === '/' ? '' : basePath}`;
	return {
		lang: loc,
		href: `${siteUrl}${locPath === '' ? '/' : locPath}`,
	};
});

const xDefaultHref = `${siteUrl}${basePath}`;
---
<!doctype html>
<html lang={currentLocale} dir={dir}>
	<head>
		<script is:inline>
	const savedTheme = localStorage.getItem("theme");

	const theme =
		savedTheme ||
		(window.matchMedia("(prefers-color-scheme: dark)").matches
			? "dark"
			: "light");

	document.documentElement.classList.toggle("dark", theme === "dark");
</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta name="generator" content={Astro.generator} />

		{!noindex && <link rel="canonical" href={computedCanonical} />}
		{!noindex && (
			<>
				{hreflangLinks.map((link) => (
					<link rel="alternate" hreflang={link.lang} href={link.href} />
				))}
				<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
			</>
		)}
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" href="/favicon.ico" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
				<meta property="og:site_name" content="The Peak Collection" />
		<meta property="og:url" content={computedCanonical} />
		<meta property="og:image" content={defaultOgImage} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={defaultOgImage} />

		<meta
			name="theme-color"
			content="#111111"
		/>
	</head>

	<body>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
<BackToTop />
	</body>
</html>
