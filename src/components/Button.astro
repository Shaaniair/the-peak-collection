---
interface Props {
	href: string;
	variant?: "primary" | "secondary" | "accent" | "text";
	size?: "small" | "medium" | "large";
	class?: string;
	target?: string;
	rel?: string;
	disabled?: boolean;
}

const {
	href,
	variant = "primary",
	size = "medium",
	class: className = "",
	target,
	rel,
	disabled = false,
} = Astro.props;

const classes = ["button", `button--${variant}`, `button--${size}`, className]
	.filter(Boolean)
	.join(" ");
---

<a
	href={href}
	class={classes}
	target={target}
	rel={rel}
	aria-disabled={disabled ? "true" : undefined}
	tabindex={disabled ? -1 : undefined}
>
	<span class="button__label"><slot /></span>
	<span class="button__arrow cta-arrow" aria-hidden="true">
		<span class="cta-arrow__resting">→</span>
		<span class="cta-arrow__lifted">↗</span>
	</span>
</a>

<style>
	.button {
		position: relative;
		isolation: isolate;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		overflow: hidden;
		border: 1px solid transparent;
		border-radius: 999px;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.01em;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: transform var(--transition-emphasis), background var(--transition-emphasis), color var(--transition-emphasis), border-color var(--transition-emphasis), box-shadow var(--transition-emphasis);
	}
	.button::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: -80%;
		z-index: 0;
		width: 55%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.42), transparent);
		transform: skewX(-18deg);
		transition: left 600ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.button:hover::before { left: 125%; }

	.button__label,
	.button__arrow { position: relative; z-index: 1; }
	.button__arrow { font-size: 1rem; line-height: 1; }

	.button--small { min-height: var(--button-height-small); padding: 0.68rem 0.95rem; font-size: 0.82rem; }
	.button--medium { min-height: var(--button-height-medium); padding: 0.82rem 1.2rem; font-size: 0.9rem; }
	.button--large { min-height: var(--button-height-large); padding: 0.85rem 1.3rem; font-size: 0.96rem; }

	.button--primary {
		background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover));
		color: #08232b !important;
		border-color: var(--color-glass-border);
		box-shadow: 0 8px 22px rgba(8, 145, 178, 0.2), inset 0 1px 0 var(--color-glass-highlight);
	}
	.button--primary:hover {
		background: linear-gradient(135deg, var(--color-action-hover), var(--color-accent));
		border-color: rgba(255, 255, 255, 0.38);
		transform: translateY(-2px);
		box-shadow: var(--shadow-button-hover);
	}
	.button--primary:active { transform: translateY(0) scale(0.99); }

	.button--secondary {
		background: var(--color-surface-solid);
		color: var(--color-text-strong) !important;
		border-color: var(--color-glass-border);
		box-shadow: inset 0 1px 0 var(--color-glass-highlight);
	}
	.button--secondary:hover {
		transform: translateY(-1px);
		background: var(--color-accent-soft);
		border-color: var(--color-action-hover);
		box-shadow: 0 7px 18px var(--color-action-glow), 0 0 0 1px var(--color-violet-glow);
	}

	.button--accent {
		background: var(--color-violet-soft);
		color: var(--color-secondary) !important;
		border-color: var(--color-violet-border);
		box-shadow: inset 0 1px 0 var(--color-glass-highlight), 0 5px 16px var(--color-violet-glow);
	}
	.button--accent:hover {
		transform: translateY(-2px);
		background: var(--color-accent-soft);
		color: var(--color-text-strong) !important;
		border-color: var(--color-action-hover);
		box-shadow: var(--shadow-button-hover);
	}
	.button--accent:active { transform: translateY(0) scale(0.99); }

	.button--text {
		padding: 0.45rem 0;
		background: transparent;
		color: var(--color-accent-strong) !important;
		border: 0;
		border-radius: 0;
	}
	.button--text:hover { color: var(--color-action-hover) !important; text-shadow: 0 0 14px var(--color-action-glow); }
	.button:hover { opacity: 1; }
	.button[aria-disabled="true"] {
		pointer-events: none;
		opacity: 0.55;
		box-shadow: none;
		transform: none;
		cursor: not-allowed;
	}

	.button:focus-visible {
		outline: 3px solid var(--color-accent-strong);
		outline-offset: 4px;
	}
	.button:active { transition-duration: 100ms; }

	@supports (backdrop-filter: blur(1px)) {
		.button--primary,
		.button--secondary,
		.button--accent {
			backdrop-filter: blur(12px) saturate(135%);
			-webkit-backdrop-filter: blur(12px) saturate(135%);
		}

		.button--primary {
			background: linear-gradient(135deg, rgba(34, 211, 238, 0.94), rgba(165, 243, 252, 0.86));
		}

		.button--secondary { background: var(--color-glass-surface); }
		.button--accent { background: color-mix(in srgb, var(--color-secondary) 9%, var(--color-glass-surface)); }
	}

	@media (prefers-reduced-motion: reduce) {
		.button,
		.button::before { transition: none; }
		.button:hover { transform: none; text-shadow: none; }
	}
</style>
