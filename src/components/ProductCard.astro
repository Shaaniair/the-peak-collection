---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	description: string;
	category?: string;
	image?: ImageMetadata;
	href: string;
	featured?: boolean;
}
const {
	title,
	description,
	category,
	image,
	href,
	featured = false,
} = Astro.props;
---

<article class:list={["product-card", { "product-card--featured": featured }]}>
	{image && (
		<a href={href} class="product-card__image-link" aria-label={`View ${title}`}>
			<Image
	src={image}
	alt={title}
	class="product-card__image"
	loading="lazy"
/>
		</a>
	)}

	<div class="product-card__body">
		{category && <p class="product-card__category">{category}</p>}

		<h3 class="product-card__title">
			<a href={href}>{title}</a>
		</h3>

		<p class="product-card__description">{description}</p>

		<a href={href} class="product-card__link">
			View Product <span aria-hidden="true">→</span>
		</a>
	</div>
</article>

<style>
	.product-card {
		height: 100%;
		display: flex;
		flex-direction: column;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow: hidden;
		transition:
			transform var(--transition-normal),
			box-shadow var(--transition-normal),
			border-color var(--transition-normal);
	}

	.product-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-md);
		border-color: #d5d1c9;
	}

	.product-card__image-link {
		display: block;
		overflow: hidden;
		background: #f3f1ec;
	}

	.product-card__image {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform 280ms ease;
	}

	.product-card:hover .product-card__image {
		transform: scale(1.03);
	}

	.product-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.5rem;
	}

	.product-card__category {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.product-card__title {
		margin: 0;
		font-size: 1.5rem;
	}

	.product-card__title a {
		text-decoration: none;
	}

	.product-card__description {
		margin: 0.75rem 0 1.25rem;
		color: var(--color-muted);
		line-height: 1.65;
	}

	.product-card__link {
		margin-top: auto;
		font-weight: 700;
		text-decoration: none;
	}

	.product-card__link span {
		display: inline-block;
		transition: transform 180ms ease;
	}

	.product-card__link:hover span {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.product-card,
		.product-card__image,
		.product-card__link span {
			transition: none;
		}
	}
</style>