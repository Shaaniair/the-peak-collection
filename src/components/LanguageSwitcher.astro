---
import { getRelativeLocaleUrl } from "astro:i18n";

const languages = [
	{ code: "en", native: "English" },
	{ code: "tr", native: "Türkçe" },
	{ code: "ar", native: "العربية" },
	{ code: "ur", native: "اردو" },
	{ code: "es", native: "Español" },
	{ code: "fr", native: "Français" },
	{ code: "de", native: "Deutsch" },
	{ code: "it", native: "Italiano" },
	{ code: "pt", native: "Português" },
	{ code: "id", native: "Bahasa Indonesia" },
	{ code: "ja", native: "日本語" },
	{ code: "ko", native: "한국어" },
	{ code: "zh", native: "中文" },
];

const locale = Astro.currentLocale ?? "en";

const localePattern = new RegExp(
	`^/(${languages.map((language) => language.code).join("|")})(?=/|$)`,
);

const currentPath = Astro.url.pathname.replace(localePattern, "");

const cleanPath =
	currentPath === "/" ? "" : currentPath.replace(/^\/+/, "");

const getLanguageUrl = (code: string) => {
	return getRelativeLocaleUrl(code, cleanPath);
};
---

<div class="language-switcher">
	<label for="language-select" class="sr-only">
		Choose language
	</label>

	<select
		id="language-select"
		class="language-select"
		data-language-select
		aria-label="Choose language"
	>
		{
			languages.map((language) => (
				<option
					value={getLanguageUrl(language.code)}
					selected={locale === language.code}
				>
					{language.native}
				</option>
			))
		}
	</select>
</div>

<style>
	.language-switcher {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
	}

	.language-select {
		min-width: 104px;
		height: 42px;
		padding: 0 2.25rem 0 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		font-size: 0.8rem;
		font-weight: 650;
		cursor: pointer;
		outline: none;
		appearance: auto;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	.language-select:hover {
		transform: translateY(-2px);
		border-color: var(--color-text);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
	}

	.language-select:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 560px) {
		.language-select {
			min-width: 82px;
			height: 38px;
			padding-left: 0.6rem;
			padding-right: 1.7rem;
			font-size: 0.75rem;
			border-radius: 10px;
		}
	}
</style>

<script>
	const setupLanguageSwitcher = () => {
		const select = document.querySelector("[data-language-select]");

		if (!(select instanceof HTMLSelectElement)) return;

		select.onchange = () => {
			const destination = select.value;

			if (destination) {
				window.location.href = destination;
			}
		};
	};

	document.addEventListener("astro:page-load", setupLanguageSwitcher);
	setupLanguageSwitcher();
</script>