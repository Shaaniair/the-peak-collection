---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.astro";

interface Props {
	title: string;
	description: string;
	href: string;
	category?: string;
	date?: Date;
	image?: ImageMetadata;
}

const {
	title,
	description,
	href,
	category,
	date,
	image,
} = Astro.props;

const formattedDate = date
	? new Intl.DateTimeFormat("en-US", {
			month: "long",
			day: "numeric",
			year: "numeric",
		}).format(date)
	: undefined;
---

<article class="guide-card">
	{image && (
		<a
			href={href}
			class="guide-card__image-link"
			aria-label={`Read ${title}`}
		>
			<Image
				src={image}
				alt={title}
				class="guide-card__image"
				loading="lazy"
			/>
		</a>
	)}

	<div class="guide-card__content">
		{category && (
			<p class="guide-card__eyebrow">{category}</p>
		)}

		<h3>
			<a href={href}>{title}</a>
		</h3>

		{formattedDate && (
			<p class="guide-card__date">{formattedDate}</p>
		)}

		<p class="guide-card__description">
			{description}
		</p>

		<div class="guide-card__action">
			<Button href={href} variant="primary" size="small">
				Read Guide
			</Button>
		</div>
	</div>
</article>

<style>
	.guide-card {
		height: 100%;

		display: flex;
		flex-direction: column;

		background: var(--color-surface);

		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);

		overflow: hidden;

		transition:
			transform var(--transition-normal),
			box-shadow var(--transition-normal),
			border-color var(--transition-normal);
	}

	.guide-card:hover {
		transform: translateY(-5px);

		box-shadow: var(--shadow-md);

		border-color: #d5d1c9;
	}

	.guide-card__image-link {
		display: block;

		overflow: hidden;

		background: #f3f1ec;
	}

	.guide-card__image {
		display: block;

		width: 100%;

		aspect-ratio: 16 / 9;

		object-fit: cover;

		transition:
			transform 280ms ease;
	}

	.guide-card:hover .guide-card__image {
		transform: scale(1.03);
	}

	.guide-card__content {
		display: flex;
		flex: 1;
		flex-direction: column;

		padding: 1.5rem;
	}

	.guide-card__eyebrow {
		margin: 0 0 0.6rem;

		font-size: 0.75rem;
		font-weight: 800;

		letter-spacing: 0.08em;
		text-transform: uppercase;

		color: var(--color-muted);
	}

	.guide-card h3 {
		margin: 0;

		font-size: 1.5rem;
		line-height: 1.2;
	}

	.guide-card h3 a {
		text-decoration: none;
	}

	.guide-card__date {
		margin: 0.65rem 0 0;

		font-size: 0.82rem;

		color: var(--color-muted);
	}

	.guide-card__description {
		margin: 0.85rem 0 1.25rem;

		color: var(--color-muted);

		line-height: 1.65;
	}

	.guide-card__action {
		display: flex;

		align-items: flex-start;

		margin-top: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.guide-card,
		.guide-card__image {
			transition: none;
		}
	}
</style>