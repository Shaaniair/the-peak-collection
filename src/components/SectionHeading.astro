---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	align?: "left" | "center";
	level?: "h1" | "h2" | "h3";
	class?: string;
}

const {
	eyebrow,
	title,
	description,
	align = "left",
	level = "h2",
	class: className = "",
} = Astro.props;

const classes = [
	"section-heading",
	`section-heading--${align}`,
	className,
]
	.filter(Boolean)
	.join(" ");
---

<div class={classes}>
	{eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}

	{level === "h1" ? (
		<h1>{title}</h1>
	) : level === "h3" ? (
		<h3>{title}</h3>
	) : (
		<h2>{title}</h2>
	)}

	{description && <p>{description}</p>}
</div>

<style>
	.section-heading {
		margin-bottom: 32px;
	}
	
.section-heading__eyebrow {
	margin: 0 0 0.75rem;
	font-size: 0.78rem;
	font-weight: 800;
	letter-spacing: 0.14em;
	text-transform: uppercase;
	color: var(--color-muted);
}

.section-heading h1,
.section-heading h2,
.section-heading h3 {
	margin: 0;
	color: var(--color-text);
	font-weight: 700;
	letter-spacing: -0.03em;
	line-height: 1.15;
}

	.section-heading h1 {
		font-size: clamp(32px, 5vw, 52px);
	}

	.section-heading h2 {
		font-size: clamp(28px, 4vw, 40px);
	}

	.section-heading h3 {
		font-size: clamp(22px, 3vw, 30px);
	}

	.section-heading p {
	max-width: 680px;
	margin: 12px 0 0;
	color: var(--color-muted);
	font-size: 16px;
	line-height: 1.65;
}

	.section-heading--center {
		text-align: center;
	}

	.section-heading--center p {
		margin-left: auto;
		margin-right: auto;
	}

	@media (max-width: 640px) {
		.section-heading {
			margin-bottom: 24px;
		}

		.section-heading p {
			font-size: 15px;
		}
	}

		@media (prefers-reduced-motion: reduce) {
		.section-heading {
			scroll-behavior: auto;
		}
	}

html.dark .section-heading h1,
html.dark .section-heading h2,
html.dark .section-heading h3 {
	color: var(--color-text-strong);
}

html.dark .section-heading__eyebrow {
	color: var(--color-accent);
}

html.dark .section-heading p {
	color: var(--color-muted);
}

</style>
