---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SearchDialog from "./SearchDialog.astro";

const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale as any);
const homeUrl = getRelativeLocaleUrl(locale);
const pageUrl = (path: string) => getRelativeLocaleUrl(locale, path);
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (path: string) => {
	const target = pageUrl(path).replace(/\/+$/, "") || "/";
	return currentPath === target || (path !== "" && currentPath.startsWith(`${target}/`));
};
---

<header class="site-header">
	<div class="header-inner">
		<a href={homeUrl} class="brand" aria-label="The Peak Collection home">
			<span class="brand-mark" aria-hidden="true">
				<span class="brand-mark__glow"></span>
				<span class="brand-mark__peak"></span>
				<span class="brand-mark__text">TPC</span>
			</span>

			<span class="brand-name">
				<span class="brand-name__the">The</span>
				<span class="brand-name__main">Peak Collection</span>
			</span>
		</a>

				<nav class="main-nav" aria-label="Main navigation">
			<a class="header-control header-control--nav" href={homeUrl} aria-current={isCurrent("") ? "page" : undefined}>{t('nav.home')}</a>
			<a class="header-control header-control--nav" href={pageUrl("discover")} aria-current={isCurrent("discover") ? "page" : undefined}>{t('nav.discover')}</a>
			<a class="header-control header-control--nav" href={pageUrl("categories")} aria-current={isCurrent("categories") ? "page" : undefined}>{t('nav.categories')}</a>
			<a class="header-control header-control--nav" href={pageUrl("guides")} aria-current={isCurrent("guides") ? "page" : undefined}>{t('nav.guides')}</a>
			<div class="nav-product-group" data-products-menu>
				<a class="header-control header-control--nav" href={pageUrl("products")} aria-current={isCurrent("products") ? "page" : undefined}>{t('nav.products')}</a>
				<button
					class="header-control header-control--nav product-menu-toggle"
					type="button"
					aria-label="Toggle product destinations"
					aria-expanded="false"
					aria-controls="products-submenu"
					data-products-toggle
				>
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg>
				</button>
				<ul class="product-submenu" id="products-submenu" aria-label="Product destinations" data-products-submenu>
					<li>
						<a class="header-control product-submenu__link" href={pageUrl("digital-products")} aria-current={isCurrent("digital-products") ? "page" : undefined}>
							{t('nav.digitalProducts')}
						</a>
					</li>
				</ul>
			</div>
			<a class="header-control header-control--nav" href={pageUrl("about")} aria-current={isCurrent("about") ? "page" : undefined}>{t('nav.about')}</a>
		</nav>

		<div class="header-tools" aria-label="Site preferences">
			<SearchDialog />
			<LanguageSwitcher />
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	/* =========================================================
	   TPC HEADER
	   The Peak Collection — Brand Identity
	   ========================================================= */

	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;

		background: color-mix(
			in srgb,
			var(--color-background) 92%,
			transparent
		);

		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);

		border-bottom: 1px solid var(--color-border);
	}

	.header-inner {
		width: min(calc(100% - 2rem), var(--container));
		min-height: 76px;
		margin-inline: auto;

		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.75rem;
	}

	/* =========================================================
	   BRAND
	   ========================================================= */

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;

		flex-shrink: 0;

		color: var(--color-text-strong) !important;
		text-decoration: none;
	}

	/* ---------------------------------------------------------
	   BRAND MARK
	   --------------------------------------------------------- */

	.brand-mark {
		position: relative;

		display: inline-flex;
		align-items: center;
		justify-content: center;

		width: 44px;
		height: 44px;

		border-radius: 13px;

		overflow: hidden;
		isolation: isolate;

		background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));

		box-shadow: 0 6px 16px rgba(8, 127, 152, 0.2);

		transition:
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 220ms ease,
			filter 220ms ease;
	}

	/* Inner glass layer */
	.brand-mark::before {
		content: "";

		position: absolute;
		inset: 1px;

		border-radius: 12px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.28),
				rgba(255, 255, 255, 0.04) 48%,
				rgba(0, 0, 0, 0.12)
			);

		z-index: -1;
	}

	/* Soft luminous edge */
	.brand-mark::after {
		content: "";

		position: absolute;
		inset: 0;

		border-radius: inherit;

		border: 1px solid rgba(255, 255, 255, 0.42);

		pointer-events: none;

		z-index: 5;
	}

	.brand:hover .brand-mark {
		transform: translateY(-2px) rotate(-1deg);

		filter: saturate(1.12);

		box-shadow:
			0 12px 28px rgba(124, 58, 237, 0.28),
			0 0 22px rgba(6, 182, 212, 0.12);
	}

	/* ---------------------------------------------------------
	   PEAK / MOUNTAIN MOTIF
	   --------------------------------------------------------- */

	.brand-mark__peak {
		position: absolute;

		left: 6px;
		right: 6px;
		bottom: 7px;

		height: 18px;

		opacity: 0.9;

		background:
			linear-gradient(
				135deg,
				transparent 0 25%,
				rgba(255, 255, 255, 0.92) 26% 29%,
				transparent 30% 47%,
				rgba(255, 255, 255, 0.62) 48% 51%,
				transparent 52%
			);

		clip-path: polygon(
			0 100%,
			25% 44%,
			38% 67%,
			58% 12%,
			76% 55%,
			100% 100%
		);

		filter:
			drop-shadow(0 2px 4px rgba(0, 0, 0, 0.18));

		pointer-events: none;
		z-index: 1;
	}

	/* ---------------------------------------------------------
	   TPC MONOGRAM
	   --------------------------------------------------------- */

	.brand-mark__text {
		position: relative;

		z-index: 4;

		display: inline-block;

		font-family: var(--font-display);

		font-size: 0.68rem;
		font-weight: 900;

		line-height: 1;
		letter-spacing: 0.08em;

		color: #ffffff;

		text-shadow:
			0 1px 3px rgba(0, 0, 0, 0.28);
	}

	/* Small highlight crossing the mark */
	.brand-mark__glow {
		position: absolute;

		top: -40%;
		left: -75%;

		width: 55%;
		height: 180%;

		background:
			linear-gradient(
				90deg,
				transparent,
				rgba(255, 255, 255, 0.52),
				transparent
			);

		transform: rotate(22deg);

		pointer-events: none;
		z-index: 3;

		transition:
			left 550ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.brand:hover .brand-mark__glow {
		left: 125%;
	}

	/* =========================================================
	   BRAND NAME
	   ========================================================= */

	.brand-name {
		display: inline-flex;
		align-items: baseline;
		gap: 0.28rem;

		font-family: var(--font-display);

		font-size: 1.1rem;
		font-weight: 700;

		line-height: 1;

		letter-spacing: -0.025em;
		white-space: nowrap;

		color: var(--color-text-strong) !important;
	}

	.brand-name__the {
		font-size: 0.72em;
		font-weight: 600;

		letter-spacing: -0.01em;

		color: var(--color-muted);
	}

	.brand-name__main {
		background: linear-gradient(100deg, var(--color-text-strong) 0%, var(--color-accent-strong) 100%);

		-webkit-background-clip: text;
		background-clip: text;

		color: transparent;
	}

	/* =========================================================
	   MAIN NAVIGATION
	   ========================================================= */

	.main-nav {
		display: flex;
		align-items: center;
		justify-content: center;

		gap: 0.25rem;
		padding-block: 4px;
		margin-inline: auto;
	}

	.main-nav a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding-inline: 0.65rem;

		color: var(--color-text);

		font-size: 0.9rem;
		font-weight: 600;

		text-decoration: none;
		white-space: nowrap;

		opacity: 0.82;

	}

	.nav-product-group {
		position: relative;
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
	}

	.product-menu-toggle {
		display: inline-grid;
		place-items: center;
		width: var(--button-height-small);
		padding: 0;
		cursor: pointer;
	}

	.product-menu-toggle svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform var(--transition-fast);
	}

	.nav-product-group[data-open="true"] .product-menu-toggle svg {
		transform: rotate(180deg);
	}

	.product-submenu {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 1002;
		width: max-content;
		max-width: min(18rem, calc(100vw - 2rem));
		margin: 0;
		padding: 0.35rem 0 0;
		list-style: none;
		visibility: hidden;
		opacity: 0;
		transform: translateY(-4px);
		transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
	}

	.nav-product-group[data-open="true"] .product-submenu {
		visibility: visible;
		opacity: 1;
		transform: translateY(0);
	}

	.product-submenu__link {
		display: flex;
		align-items: center;
		min-height: var(--button-height-small);
		padding: 0.55rem 0.8rem;
		color: var(--color-text-strong);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		white-space: normal;
		border: 1px solid var(--color-glass-border);
		border-radius: var(--radius-control);
		background: var(--color-glass-surface);
		box-shadow: var(--shadow-md), 0 0 16px var(--color-action-glow);
		backdrop-filter: blur(16px) saturate(135%);
		-webkit-backdrop-filter: blur(16px) saturate(135%);
	}

	/* =========================================================
	   HEADER TOOLS
	   ========================================================= */

	.header-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;

		gap: 0.6rem;

		flex-shrink: 0;
	}

	/* =========================================================
	   TABLET / SMALL DESKTOP
	   ========================================================= */

	@media (max-width: 1050px) {
		.header-inner {
			gap: 1rem;
		}

		.main-nav {
			flex: 1 1 auto;
			min-width: 0;
			justify-content: flex-start;
			flex-wrap: wrap;
			gap: 0.15rem;
			overflow: visible;
		}

		.main-nav a {
			font-size: 0.84rem;
		}
	}

	/* =========================================================
	   TABLET
	   ========================================================= */

	@media (max-width: 900px) {
		.header-inner {
			min-height: 70px;
		}

		.brand-name {
			display: none;
		}

		.main-nav {
			gap: 0.1rem;
			flex-wrap: wrap;
			overflow: visible;
		}

		.main-nav a {
			font-size: 0.82rem;
		}
	}

	@media (max-width: 680px) {
		.product-submenu {
			left: auto;
			right: 0;
		}
	}

	/* =========================================================
	   MOBILE
	   ========================================================= */

	@media (max-width: 680px) {
		.header-inner {
			width: min(calc(100% - 1rem), var(--container));

			min-height: 66px;

			gap: 0.7rem;
		}

		.brand-mark {
			width: 38px;
			height: 38px;

			border-radius: 11px;
		}

		.brand-mark__text {
			font-size: 0.61rem;
		}

		.main-nav {
			order: 3;

			flex: 1 1 100%;
			width: 100%;

			justify-content: flex-start;
		}

		.header-inner {
			flex-wrap: wrap;
			padding-block: 0.55rem;
		}

		.header-tools {
			margin-left: auto;
		}
	}

	@media (max-width: 480px) {
		.main-nav {
			gap: 0.05rem;
		}

		.main-nav a {
			font-size: 0.76rem;
		}

		.header-tools {
			gap: 0.4rem;
		}
	}

	/* =========================================================
	   DARK MODE — HEADER
	   ========================================================= */

	html.dark .site-header {
		background: rgba(9, 9, 11, 0.82);

		border-bottom-color:
			rgba(255, 255, 255, 0.1);

		box-shadow:
			0 8px 30px rgba(0, 0, 0, 0.18);
	}

	html.dark .brand {
		color: #ffffff !important;
	}

	html.dark .brand-mark {
		background:
			linear-gradient(
				135deg,
				#ddd6fe 0%,
				#a78bfa 28%,
				#67e8f9 68%,
				#fbbf24 100%
			);

		box-shadow:
			0 9px 26px rgba(124, 58, 237, 0.28),
			0 0 22px rgba(103, 232, 249, 0.08);
	}

	html.dark .brand-mark::before {
		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.46),
				rgba(255, 255, 255, 0.08) 48%,
				rgba(0, 0, 0, 0.18)
			);
	}

	html.dark .brand-mark::after {
		border-color:
			rgba(255, 255, 255, 0.5);
	}

	html.dark .brand-mark__text {
		color: #0b0b0f;

		text-shadow:
			0 1px 2px rgba(255, 255, 255, 0.25);
	}

	html.dark .brand-mark__peak {
		opacity: 0.52;

		filter:
			drop-shadow(0 2px 4px rgba(255, 255, 255, 0.1));
	}

	html.dark .brand-name {
		color: #ffffff !important;
	}

	html.dark .brand-name__the {
		color: #a9a9b5;
	}

	html.dark .brand-name__main {
		background:
			linear-gradient(
				100deg,
				#ffffff 0%,
				#ddd6fe 50%,
				#67e8f9 100%
			);

		-webkit-background-clip: text;
		background-clip: text;

		color: transparent;
	}

	html.dark .main-nav a {
		color: #d7d7df;
		opacity: 0.9;
	}

	html.dark .main-nav a:hover {
		color: #ffffff;
		opacity: 1;
	}

	/* =========================================================
	   TPC DARK MODE — HOME EXPERIENCE
	   ========================================================= */

	html.dark .hero {
		background:
			radial-gradient(
				circle at 78% 18%,
				rgba(124, 58, 237, 0.24),
				transparent 30%
			),
			radial-gradient(
				circle at 20% 70%,
				rgba(6, 182, 212, 0.12),
				transparent 28%
			),
			linear-gradient(
				180deg,
				#09090b 0%,
				#111116 55%,
				#0d0d0f 100%
			);
	}

	html.dark .hero .eyebrow {
		color: #a78bfa;
	}

	html.dark .hero h1 {
		background:
			linear-gradient(
				120deg,
				#ffffff 0%,
				#c4b5fd 45%,
				#67e8f9 100%
			);

		-webkit-background-clip: text;
		background-clip: text;

		color: transparent;
	}

	html.dark .hero__description {
		color: #b7b7c2;
	}

	html.dark .section {
		background: #0d0d0f;
	}

	html.dark .section--muted {
		background:
			linear-gradient(
				135deg,
				#111116 0%,
				#15151b 50%,
				#0f172a 100%
			);
	}

	html.dark .explore-card {
		background: rgba(255, 255, 255, 0.045);

		border-color:
			rgba(255, 255, 255, 0.12);

		color: #ffffff;

		box-shadow:
			0 10px 40px rgba(0, 0, 0, 0.2);

		backdrop-filter: blur(12px);
	}

	html.dark .explore-card:hover {
		border-color:
			rgba(167, 139, 250, 0.5);

		box-shadow:
			0 18px 50px rgba(0, 0, 0, 0.32),
			0 0 30px rgba(124, 58, 237, 0.1);
	}

	html.dark .explore-card__number {
		color: #a78bfa;
	}

	html.dark .explore-card p {
		color: #a9a9b5;
	}

	html.dark .explore-card__link {
		color: #ffffff;
	}

	html.dark .about-preview {
		color: #ffffff;
	}

	html.dark .about-preview p {
		color: #b7b7c2;
	}

	html.dark .about-preview .eyebrow {
		color: #67e8f9;
	}

	html.dark .text-link {
		color: #c4b5fd;
	}

	html.dark .text-link:hover {
		color: #67e8f9;
	}

	/* =========================================================
	   REDUCED MOTION
	   ========================================================= */

	@media (prefers-reduced-motion: reduce) {
		.brand-mark,
		.brand-mark__glow,
		.main-nav a,
		.product-menu-toggle svg,
		.product-submenu {
			transition: none;
		}

		.brand:hover .brand-mark {
			transform: none;
		}
	}
</style>

<script>
	const productsMenu = document.querySelector<HTMLElement>("[data-products-menu]");
	const productsToggle = productsMenu?.querySelector<HTMLButtonElement>("[data-products-toggle]");
	const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");

	function setProductsMenuOpen(open: boolean) {
		if (!productsMenu || !productsToggle) return;
		productsMenu.dataset.open = String(open);
		productsToggle.setAttribute("aria-expanded", String(open));
	}

	productsMenu?.addEventListener("pointerenter", (event) => {
		if (event.pointerType === "mouse" && canHover.matches) setProductsMenuOpen(true);
	});

	productsMenu?.addEventListener("pointerleave", () => {
		if (!productsMenu?.contains(document.activeElement)) setProductsMenuOpen(false);
	});

	productsMenu?.addEventListener("focusin", (event) => {
		if (event.target !== productsToggle) setProductsMenuOpen(true);
	});
	productsMenu?.addEventListener("focusout", (event) => {
		if (!productsMenu?.contains(event.relatedTarget as Node | null)) setProductsMenuOpen(false);
	});

	productsToggle?.addEventListener("click", () => {
		setProductsMenuOpen(productsToggle.getAttribute("aria-expanded") !== "true");
	});

	document.addEventListener("pointerdown", (event) => {
		if (productsMenu && !productsMenu.contains(event.target as Node)) setProductsMenuOpen(false);
	});

	productsMenu?.addEventListener("keydown", (event) => {
		if (event.key !== "Escape" || productsToggle?.getAttribute("aria-expanded") !== "true") return;
		event.preventDefault();
		setProductsMenuOpen(false);
		productsToggle?.focus();
	});
</script>
