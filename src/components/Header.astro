---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

const locale = Astro.currentLocale ?? "en";
const homeUrl = getRelativeLocaleUrl(locale);
const pageUrl = (path: string) => getRelativeLocaleUrl(locale, path);
---

<header class="site-header">
	<div class="header-inner">
		<a href={homeUrl} class="brand" aria-label="The Peak Collection home">
			<span class="brand-mark" aria-hidden="true">
				<span class="brand-mark__glow"></span>
				<span class="brand-mark__peak"></span>
				<span class="brand-mark__text">TPC</span>
			</span>

			<span class="brand-name">
				<span class="brand-name__the">The</span>
				<span class="brand-name__main">Peak Collection</span>
			</span>
		</a>

		<nav class="main-nav" aria-label="Main navigation">
			<a href={homeUrl}>Home</a>
			<a href={pageUrl("discover")}>Discover</a>
			<a href={pageUrl("categories")}>Categories</a>
			<a href={pageUrl("guides")}>Guides</a>
			<a href={pageUrl("products")}>Products</a>
			<a href={pageUrl("about")}>About</a>
		</nav>

		<div class="header-tools" aria-label="Site preferences">
			<LanguageSwitcher />
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	/* =========================================================
	   TPC HEADER
	   The Peak Collection — Brand Identity
	   ========================================================= */

	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;

		background: color-mix(
			in srgb,
			var(--color-background) 92%,
			transparent
		);

		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);

		border-bottom: 1px solid var(--color-border);
	}

	.header-inner {
		width: min(calc(100% - 2rem), var(--container));
		min-height: 76px;
		margin-inline: auto;

		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.75rem;
	}

	/* =========================================================
	   BRAND
	   ========================================================= */

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;

		flex-shrink: 0;

		color: #111111 !important;
		text-decoration: none;
	}

	/* ---------------------------------------------------------
	   BRAND MARK
	   --------------------------------------------------------- */

	.brand-mark {
		position: relative;

		display: inline-flex;
		align-items: center;
		justify-content: center;

		width: 44px;
		height: 44px;

		border-radius: 13px;

		overflow: hidden;
		isolation: isolate;

		background:
			linear-gradient(
				135deg,
				#7c3aed 0%,
				#a855f7 30%,
				#06b6d4 68%,
				#f59e0b 100%
			);

		box-shadow:
			0 7px 18px rgba(124, 58, 237, 0.22),
			0 2px 5px rgba(0, 0, 0, 0.08);

		transition:
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 220ms ease,
			filter 220ms ease;
	}

	/* Inner glass layer */
	.brand-mark::before {
		content: "";

		position: absolute;
		inset: 1px;

		border-radius: 12px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.28),
				rgba(255, 255, 255, 0.04) 48%,
				rgba(0, 0, 0, 0.12)
			);

		z-index: -1;
	}

	/* Soft luminous edge */
	.brand-mark::after {
		content: "";

		position: absolute;
		inset: 0;

		border-radius: inherit;

		border: 1px solid rgba(255, 255, 255, 0.42);

		pointer-events: none;

		z-index: 5;
	}

	.brand:hover .brand-mark {
		transform: translateY(-2px) rotate(-1deg);

		filter: saturate(1.12);

		box-shadow:
			0 12px 28px rgba(124, 58, 237, 0.28),
			0 0 22px rgba(6, 182, 212, 0.12);
	}

	/* ---------------------------------------------------------
	   PEAK / MOUNTAIN MOTIF
	   --------------------------------------------------------- */

	.brand-mark__peak {
		position: absolute;

		left: 6px;
		right: 6px;
		bottom: 7px;

		height: 18px;

		opacity: 0.9;

		background:
			linear-gradient(
				135deg,
				transparent 0 25%,
				rgba(255, 255, 255, 0.92) 26% 29%,
				transparent 30% 47%,
				rgba(255, 255, 255, 0.62) 48% 51%,
				transparent 52%
			);

		clip-path: polygon(
			0 100%,
			25% 44%,
			38% 67%,
			58% 12%,
			76% 55%,
			100% 100%
		);

		filter:
			drop-shadow(0 2px 4px rgba(0, 0, 0, 0.18));

		pointer-events: none;
		z-index: 1;
	}

	/* ---------------------------------------------------------
	   TPC MONOGRAM
	   --------------------------------------------------------- */

	.brand-mark__text {
		position: relative;

		z-index: 4;

		display: inline-block;

		font-family: var(--font-display);

		font-size: 0.68rem;
		font-weight: 900;

		line-height: 1;
		letter-spacing: 0.08em;

		color: #ffffff;

		text-shadow:
			0 1px 3px rgba(0, 0, 0, 0.28);
	}

	/* Small highlight crossing the mark */
	.brand-mark__glow {
		position: absolute;

		top: -40%;
		left: -75%;

		width: 55%;
		height: 180%;

		background:
			linear-gradient(
				90deg,
				transparent,
				rgba(255, 255, 255, 0.52),
				transparent
			);

		transform: rotate(22deg);

		pointer-events: none;
		z-index: 3;

		transition:
			left 550ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.brand:hover .brand-mark__glow {
		left: 125%;
	}

	/* =========================================================
	   BRAND NAME
	   ========================================================= */

	.brand-name {
		display: inline-flex;
		align-items: baseline;
		gap: 0.28rem;

		font-family: var(--font-display);

		font-size: 1.1rem;
		font-weight: 700;

		line-height: 1;

		letter-spacing: -0.025em;
		white-space: nowrap;

		color: #111111 !important;
	}

	.brand-name__the {
		font-size: 0.72em;
		font-weight: 600;

		letter-spacing: -0.01em;

		color: #6b7280;
	}

	.brand-name__main {
		background:
			linear-gradient(
				100deg,
				#111111 0%,
				#4c1d95 55%,
				#075985 100%
			);

		-webkit-background-clip: text;
		background-clip: text;

		color: transparent;
	}

	/* =========================================================
	   MAIN NAVIGATION
	   ========================================================= */

	.main-nav {
		display: flex;
		align-items: center;
		justify-content: center;

		gap: 1.35rem;
		margin-inline: auto;
	}

	.main-nav a {
		position: relative;

		padding: 0.4rem 0;

		color: var(--color-text);

		font-size: 0.9rem;
		font-weight: 600;

		text-decoration: none;
		white-space: nowrap;

		opacity: 0.82;

		transition:
			opacity 180ms ease,
			color 180ms ease;
	}

	.main-nav a::after {
		content: "";

		position: absolute;
		left: 0;
		bottom: 0;

		width: 100%;
		height: 2px;

		background: currentColor;

		transform: scaleX(0);
		transform-origin: right;

		transition:
			transform 180ms ease;
	}

	.main-nav a:hover {
		opacity: 1;
	}

	.main-nav a:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	/* =========================================================
	   HEADER TOOLS
	   ========================================================= */

	.header-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;

		gap: 0.6rem;

		flex-shrink: 0;
	}

	/* =========================================================
	   TABLET / SMALL DESKTOP
	   ========================================================= */

	@media (max-width: 1050px) {
		.header-inner {
			gap: 1rem;
		}

		.main-nav {
			gap: 0.9rem;
		}

		.main-nav a {
			font-size: 0.84rem;
		}
	}

	/* =========================================================
	   TABLET
	   ========================================================= */

	@media (max-width: 900px) {
		.header-inner {
			min-height: 70px;
		}

		.brand-name {
			display: none;
		}

		.main-nav {
			gap: 0.8rem;

			overflow-x: auto;

			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.main-nav::-webkit-scrollbar {
			display: none;
		}

		.main-nav a {
			font-size: 0.82rem;
		}
	}

	/* =========================================================
	   MOBILE
	   ========================================================= */

	@media (max-width: 680px) {
		.header-inner {
			width: min(calc(100% - 1rem), var(--container));

			min-height: 66px;

			gap: 0.7rem;
		}

		.brand-mark {
			width: 38px;
			height: 38px;

			border-radius: 11px;
		}

		.brand-mark__text {
			font-size: 0.61rem;
		}

		.main-nav {
			order: 3;

			flex: 1 1 100%;
			width: 100%;

			justify-content: flex-start;
		}

		.header-inner {
			flex-wrap: wrap;
			padding-block: 0.55rem;
		}

		.header-tools {
			margin-left: auto;
		}
	}

	@media (max-width: 480px) {
		.main-nav {
			gap: 0.75rem;
		}

		.main-nav a {
			font-size: 0.76rem;
		}

		.header-tools {
			gap: 0.4rem;
		}
	}

	/* =========================================================
	   DARK MODE — HEADER
	   ========================================================= */

	html.dark .site-header {
		background: rgba(9, 9, 11, 0.82);

		border-bottom-color:
			rgba(255, 255, 255, 0.1);

		box-shadow:
			0 8px 30px rgba(0, 0, 0, 0.18);
	}

	html.dark .brand {
		color: #ffffff !important;
	}

	html.dark .brand-mark {
		background:
			linear-gradient(
				135deg,
				#ddd6fe 0%,
				#a78bfa 28%,
				#67e8f9 68%,
				#fbbf24 100%
			);

		box-shadow:
			0 9px 26px rgba(124, 58, 237, 0.28),
			0 0 22px rgba(103, 232, 249, 0.08);
	}

	html.dark .brand-mark::before {
		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.46),
				rgba(255, 255, 255, 0.08) 48%,
				rgba(0, 0, 0, 0.18)
			);
	}

	html.dark .brand-mark::after {
		border-color:
			rgba(255, 255, 255, 0.5);
	}

	html.dark .brand-mark__text {
		color: #0b0b0f;

		text-shadow:
			0 1px 2px rgba(255, 255, 255, 0.25);
	}

	html.dark .brand-mark__peak {
		opacity: 0.52;

		filter:
			drop-shadow(0 2px 4px rgba(255, 255, 255, 0.1));
	}

	html.dark .brand-name {
		color: #ffffff !important;
	}

	html.dark .brand-name__the {
		color: #a9a9b5;
	}

	html.dark .brand-name__main {
		background:
			linear-gradient(
				100deg,
				#ffffff 0%,
				#ddd6fe 50%,
				#67e8f9 100%
			);

		-webkit-background-clip: text;
		background-clip: text;

		color: transparent;
	}

	html.dark .main-nav a {
		color: #d7d7df;
		opacity: 0.9;
	}

	html.dark .main-nav a:hover {
		color: #ffffff;
		opacity: 1;
	}

	/* =========================================================
	   TPC DARK MODE — HOME EXPERIENCE
	   ========================================================= */

	html.dark .hero {
		background:
			radial-gradient(
				circle at 78% 18%,
				rgba(124, 58, 237, 0.24),
				transparent 30%
			),
			radial-gradient(
				circle at 20% 70%,
				rgba(6, 182, 212, 0.12),
				transparent 28%
			),
			linear-gradient(
				180deg,
				#09090b 0%,
				#111116 55%,
				#0d0d0f 100%
			);
	}

	html.dark .hero .eyebrow {
		color: #a78bfa;
	}

	html.dark .hero h1 {
		background:
			linear-gradient(
				120deg,
				#ffffff 0%,
				#c4b5fd 45%,
				#67e8f9 100%
			);

		-webkit-background-clip: text;
		background-clip: text;

		color: transparent;
	}

	html.dark .hero__description {
		color: #b7b7c2;
	}

	html.dark .section {
		background: #0d0d0f;
	}

	html.dark .section--muted {
		background:
			linear-gradient(
				135deg,
				#111116 0%,
				#15151b 50%,
				#0f172a 100%
			);
	}

	html.dark .explore-card {
		background: rgba(255, 255, 255, 0.045);

		border-color:
			rgba(255, 255, 255, 0.12);

		color: #ffffff;

		box-shadow:
			0 10px 40px rgba(0, 0, 0, 0.2);

		backdrop-filter: blur(12px);
	}

	html.dark .explore-card:hover {
		border-color:
			rgba(167, 139, 250, 0.5);

		box-shadow:
			0 18px 50px rgba(0, 0, 0, 0.32),
			0 0 30px rgba(124, 58, 237, 0.1);
	}

	html.dark .explore-card__number {
		color: #a78bfa;
	}

	html.dark .explore-card p {
		color: #a9a9b5;
	}

	html.dark .explore-card__link {
		color: #ffffff;
	}

	html.dark .about-preview {
		color: #ffffff;
	}

	html.dark .about-preview p {
		color: #b7b7c2;
	}

	html.dark .about-preview .eyebrow {
		color: #67e8f9;
	}

	html.dark .text-link {
		color: #c4b5fd;
	}

	html.dark .text-link:hover {
		color: #67e8f9;
	}

	/* =========================================================
	   REDUCED MOTION
	   ========================================================= */

	@media (prefers-reduced-motion: reduce) {
		.brand-mark,
		.brand-mark__glow,
		.main-nav a,
		.main-nav a::after {
			transition: none;
		}

		.brand:hover .brand-mark {
			transform: none;
		}
	}
</style>